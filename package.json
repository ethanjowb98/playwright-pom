{
  "name": "playwright-pom",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api --project=stateful --grep @api",
    "test:e2e": "playwright test --project=e2e-chromium --project=stateful --grep @e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:setup": "playwright test --project=setup",
    "test:repeat": "playwright test --repeat-each=3 --grep-invert @login",
    "test:login": "playwright test --grep @login",
    "test:maintenance": "playwright test --project=maintenance",
    "test:unit": "tsx --test \"scripts/**/*.test.ts\"",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open",
    "analyze": "tsx scripts/analyze-failures.ts",
    "report:site": "tsx scripts/report-site.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:md && npm run test:unit",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "description": "Playwright POM test automation (API + E2E) for the qacloud.dev Market app",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "allure": "^3.22.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ]
  }
}
