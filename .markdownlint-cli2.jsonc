{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
  },
  "globs": [
    "*.md",
    "docs/**/*.md",
    "specs/**/*.md",
    "templates/**/*.md",
    ".github/**/*.md",
    ".claude/**/*.md",
  ],
  "ignores": ["node_modules/**", "CHANGELOG.md", "failure-analysis.md"],
}
