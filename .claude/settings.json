{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git switch -c feat/m:*)",
      "PowerShell(npx playwright test:*)",
      "PowerShell(npm run:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "Bash(ls -la \"C:/Users/eowyn/Downloads/allure-report\" 2>&1 | head -8; du -sh \"C:/Users/eowyn/Downloads/allure-report\" 2>&1; ls \"C:/Users/eowyn/Downloads/allure-report/data/attachments\" 2>/dev/null | wc -l; du -sh \"C:/Users/eowyn/Downloads/allure-report/data/attachments\" 2>/dev/null)",
      "Read(//c/Users/eowyn/Downloads/allure-report/**)",
      "Read(//c/Users/eowyn/Downloads/allure-report/data/attachments/**)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr merge:*)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.auth/**)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-writes.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\""
          }
        ]
      }
    ]
  }
}
